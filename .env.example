# SQLite 数据文件（相对项目根目录）
DB_FILE=data/app.sqlite
DB_PREFIX=ba_
DB_DATABASE=sqlite
# Token 签名密钥。上线时务必改成独立随机串，并保持不变
TOKEN_KEY=
TOKEN_ALGO=ripemd160
PORT=8002
CORS_ORIGIN=localhost,127.0.0.1
VITE_AXIOS_BASE_URL=getCurrentDomain

# 仅在执行 pnpm import:sqlite 从 MySQL 导入初始数据时需要填写
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=buildadmin_com
# DB_USERNAME=root
# DB_PASSWORD=
